# Fetched third-party tools (see config/pipeline.yaml)
/tools/

# Build and run artifacts
/build/
/runs/
/history/
*.bsp
*.prt
*.lin
*.pts
*.log
*.err

# Generated from maps/<map>/layout.yaml by `./mf generate` (deterministic: layout + generator
# code reproduce them byte for byte). test_box is hand-written and stays versioned.
/maps/*/src/*.map
/maps/*/src/*.rad
!/maps/test_box/src/test_box.map

# Third-party reference maps (official or community, unknown licenses): local use only
/test_maps/

# Generated assets (regenerate with `task wad`)
assets/wads/*.wad

# Local config overrides
config/*.local.yaml

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Editors
.vscode/
.idea/

# Local docker compose settings
/.env

# Playwright MCP scratch (screenshots/snapshots)
/.playwright-mcp/

# Packages handed in from other sessions (read, then integrated into the repo)
/temp/

# brief images with licence `inspiration` (from the web etc.): local only, never a texture
maps/*/brief/inspiration/

# brainstorming companion (mockups, spikes)
.superpowers/
